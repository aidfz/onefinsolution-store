# Railway private PostgreSQL URL. Configure secrets in Railway or ignored .env.local.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
NEXT_PUBLIC_SITE_URL=https://onefinsolution.net
# Optional public host cookie scope (apex domain). Leave unset for localhost.
# SESSION_COOKIE_DOMAIN=onefinsolution.net
SESSION_SECRET=replace-with-long-random-string
WORKSPACE_SIGNING_KEY=replace-with-long-random-string
WORKSPACE_CREDIT_COST=1
SIGNUP_CREDITS=100

# xAI (Grok) — optional for local chat
# XAI_API_KEY=
# XAI_MODEL=grok-4-1-fast-reasoning

# Email (Resend) — leave empty until new account is connected
# RESEND_API_KEY=
# EMAIL_FROM=One Fin Solution <noreply@onefinsolution.net>
# EMAIL_FROM_AUTH=One Fin Solution Auth <auth@onefinsolution.net>
# EMAIL_FROM_BILLING=One Fin Solution Billing <billing@onefinsolution.net>
# EMAIL_REPLY_TO=support@onefinsolution.net
# EMAIL_TEST_TO=

# Stripe — one shared account + one secret key (never commit real values)
STRIPE_MODE=test
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional guard: must match the connected Stripe account id (acct_…)
STRIPE_EXPECTED_ACCOUNT_ID=

# Subscription Price IDs (from Stripe Dashboard or scripts/provision-personal-plans.mjs)
# STRIPE_PRICE_DAILY=
# STRIPE_PRICE_WEEKLY=
# STRIPE_PRICE_MONTHLY=
# STRIPE_PRICE_YEARLY=

# Workspace credits pack Price ID
# STRIPE_PRICE_CREDITS_50=

# JSON maps — provisioned per Stripe account; do not hardcode old account IDs
# STRIPE_CREDIT_PLANS=
# STRIPE_SOFTWARE_CATALOG=

# Railway CLI targeting for scripts/configure-railway.mjs (local only)
# RAILWAY_TOKEN=
# RAILWAY_PROJECT_ID=
# RAILWAY_SERVICE_ID=
# RAILWAY_ENVIRONMENT_ID=
