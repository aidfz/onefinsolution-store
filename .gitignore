# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# any .env* besides .env.example
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local verification credentials, browser traces and reports
.test-artifacts/
playwright-report/
test-results/

# Stripe provisioner outputs (account-specific IDs / secrets)
.stripe-test-ids.json
.stripe-plan-ids.json
.env.stripe-generated
billing/personal-plan-ids.json
billing/test-ids.json

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.*.example

# Local Railway CLI dumps (may contain live secrets)
.tmp_railway/
.stripe-software-ids.json
.env.stripe-software-generated

# Local analysis / scratch dumps (not production)
_analyze/

# Windows shell artifact (accidental nul file)
/nul
.env.local
.env*.local

# Local archives and agent temp (not production)
/_archive/
.e2e-tmp/
.test-artifacts/
.tmp_railway/
.tmp/
.tmp-*
e2e-*.txt
remaining-*.txt
railway-e2e-*.txt
.env.e2e*
.env.stripe-generated

.tmp-dev.*
rw_vars_tmp.txt
# --- Migration / secrets (never commit) ---
.stripe-generated
_archive/
*secrets*.env
.railway-token
.env.stripe-live-generated
stripe-sec-keys.txt
.tmp_live_stripe_summary.json
.tmp_live_software_catalog.json
.tmp_provision_live_catalog.py
